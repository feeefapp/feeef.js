{
  "name": "feeef",
  "description": "feeef sdk for javascript",
  "version": "0.14.3",
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "clean": "del-cli build",
    "typecheck": "tsc --noEmit",
    "precompile": "npm run lint && npm run clean",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration -p tsconfig.build.json",
    "build": "npm run compile",
    "release": "npx release-it",
    "publish:npm": "bash ./scripts/publish.sh",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "lint": "eslint . && npm run lint:public-docs",
    "lint:public-docs": "node scripts/check-public-docs.mjs --self-test && node scripts/check-public-docs.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^5.3.0",
    "@japa/snapshot": "^2.0.10",
    "@swc/core": "^1.16.13",
    "@types/dlv": "^1.1.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "benchmark": "^2.1.4",
    "c8": "^12.0.0",
    "del-cli": "^8.0.0",
    "eslint": "^10.12.0",
    "github-label-sync": "^3.0.0",
    "husky": "^9.1.7",
    "joi": "^18.2.9",
    "prettier": "^3.9.9",
    "release-it": "^21.1.1",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@poppinss/ts-exec": "^1.5.0",
    "@japa/expect": "^3.0.7",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@adonisjs/transmit-client": "^1.1.0",
    "@openrouter/sdk": "^1.4.25",
    "axios": "^1.20.0",
    "axios-cache-interceptor": "^1.12.3",
    "luxon": "^3.7.2"
  },
  "author": "mohamadlounnas,feeefnet",
  "license": "MIT",
  "homepage": "https://github.com/feeefnet/feeef.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feeefnet/feeef.js.git"
  },
  "bugs": {
    "url": "https://github.com/feeefnet/feeef.js/issues"
  },
  "keywords": [],
  "types": "./build/index.d.ts",
  "prettier": "@adonisjs/prettier-config",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}",
      "web": true
    },
    "npm": {
      "publish": true,
      "skipChecks": false
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "directories": {
    "test": "tests"
  },
  "tsup": {
    "entry": [
      "./index.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": true,
    "target": "esnext"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
